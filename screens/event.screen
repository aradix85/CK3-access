# Event - how an event is read aloud.
#
# Exceptions only. Whatever this file does not name is read in the order the gui files give, so a
# file left behind by a patch costs detail and never the screen itself.
#
# Point at what the gui file says a widget shows - a data function or a name - never at a position
# in the child list and never at a coordinate. One mod adding a row inside a vanilla window shifts
# every index, and a reader that counts would quietly read the wrong field.
#
# The format is the game's own: key = value, blocks, # for a comment.
# Check it with: python tools\ck3\screens.py

screen = {
	name = "event"
	say = "Event"

	# Three windows, one way of reading. They differ in decoration, not in what they hold.
	window = "character_event"
	window = "fullscreen_event"
	window = "letter_event"

	# The reading order. What is not named here follows after it, in file order - which is where
	# the people in the picture, the artifacts and the travel line come from.
	#
	# Nothing is announced on arrival beyond the window's own first line. The count of the
	# options sits against the options, where it is about to be useful, and not in a sentence
	# you have to hear before every event.
	order = {
		read = "[EventWindowData.GetTitle]"
		read = "[EventWindowData.GetDescription]"
		read = "[EventWindowData.GetOptions]"
	}

	# The options. This is the part that has to be right: an event without its options is a
	# message, and this one is waiting for an answer.
	#
	# Inside a block the order of the lines is the order of the reading. A `state` goes in front
	# of the line it belongs to; `key` and `explain` are not read along with it.
	list = {
		of = "[EventWindowData.GetOptions]"
		count = before                        # "four options"
		close = after                         # "end of the options"

		item = {
			# State before the words. A state that arrives after the sentence arrives too
			# late to act on, and these three are exactly what a seeing player is shown by
			# the glow around the button and by the button being dead.
			state = { when = "[EventOption.HasFlag('dangerous')]" say = "dangerous" }
			state = { when = "[EventOption.HasFlag('special')]" say = "special" }
			state = { when = "[Not(EventOption.IsValid)]" say = "unavailable" }

			read = "[EventOption.GetText]"

			# What the option does to you. The game marks exactly these four kinds and
			# hands them over as a list, so they are words rather than a reading of the
			# tooltip: gold and prestige are not in here, they are in the tooltip only.
			# An item that is not a trait has no trait to name, and a nothing stays quiet.
			list = {
				of = "[EventOption.Effects]"
				item = {
					state = { when = "[OptionEffectItem.IsDeath]" say = "death" }
					state = { when = "[And(OptionEffectItem.IsStress, OptionEffectItem.IsCritical)]" say = "critical stress" }
					state = { when = "[And(OptionEffectItem.IsStress, OptionEffectItem.IsGain)]" say = "gain stress" }
					state = { when = "[And(OptionEffectItem.IsStress, OptionEffectItem.IsLoss)]" say = "lose stress" }
					state = { when = "[And(OptionEffectItem.IsTrait, OptionEffectItem.IsGain)]" say = "gain" }
					state = { when = "[And(OptionEffectItem.IsTrait, OptionEffectItem.IsLoss)]" say = "lose" }
					state = { when = "[OptionEffectItem.IsScheme]" say = "scheme" }
					read = "[OptionEffectItem.GetTrait]"
				}
			}

			key = "shift and the number of the option"

			# What the explain key reads out while standing on this option: what the game
			# itself puts in the tooltip, which is the whole of what it will do to you.
			explain = "[EventOption.GetTooltip]"
		}
	}
}
